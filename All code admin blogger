<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE html>
<html b:css='false' xmlns='http://www.w3.org/1999/xhtml' xmlns:b='http://www.google.com/2005/gml/b' xmlns:data='http://www.google.com/2005/gml/data' xmlns:expr='http://www.google.com/2005/gml/expr'>
<head>
  <meta charset='UTF-8'/>
  <meta content='width=device-width, initial-scale=1.0' name='viewport'/>
  <title>Super Admin Panel</title>
  <link href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css' rel='stylesheet'/>
  
  <b:skin><![CDATA[
    /* CSS Code */
    :root {
      --bg-color: #0b0d17;
      --card-bg: #131629;
      --input-bg: #090a12;
      --accent-purple: #a855f7;
      --btn-purple: #9333ea;
      --btn-hover: #7e22ce;
      --text-white: #f8fafc;
      --text-gray: #94a3b8;
      --border-color: rgba(168, 85, 247, 0.2);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }

    body {
      background-color: var(--bg-color);
      color: var(--text-white);
      padding: 20px 15px;
      max-width: 500px;
      margin: 0 auto;
    }

    .header-title {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      font-size: 24px;
      font-weight: 700;
      color: var(--accent-purple);
      margin-bottom: 25px;
    }

    .nav-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin-bottom: 25px;
    }

    .nav-btn {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: 14px;
      padding: 15px 10px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 8px;
      cursor: pointer;
      color: var(--text-white);
      transition: all 0.2s ease;
    }

    .nav-btn i {
      font-size: 22px;
      color: var(--accent-purple);
    }

    .nav-btn span {
      font-size: 13px;
      font-weight: 600;
    }

    .nav-btn.active {
      border: 2px solid var(--accent-purple);
      box-shadow: 0 0 12px rgba(168, 85, 247, 0.3);
    }

    .section-card {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: 16px;
      padding: 20px;
      margin-bottom: 20px;
      display: none;
    }

    .section-card.active-section {
      display: block;
    }

    .section-header {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 20px;
      font-weight: 700;
      color: var(--accent-purple);
      margin-bottom: 20px;
      padding-bottom: 10px;
      border-bottom: 1px solid rgba(255,255,255,0.05);
    }

    .sub-box {
      background: rgba(0,0,0,0.2);
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 12px;
      padding: 15px;
      margin-bottom: 18px;
    }

    .sub-box-title {
      font-size: 15px;
      font-weight: 600;
      color: #ef4444;
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    label {
      display: block;
      font-size: 13px;
      color: var(--text-gray);
      margin-top: 12px;
      margin-bottom: 6px;
    }

    input, select, textarea {
      width: 100%;
      background: var(--input-bg);
      border: 1px solid var(--border-color);
      border-radius: 10px;
      padding: 12px 14px;
      color: var(--text-white);
      font-size: 14px;
      outline: none;
    }

    input:focus, select:focus, textarea:focus {
      border-color: var(--accent-purple);
    }

    .btn-submit {
      width: 100%;
      background: var(--btn-purple);
      color: white;
      border: none;
      border-radius: 10px;
      padding: 13px;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
      margin-top: 18px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .btn-submit:hover {
      background: var(--btn-hover);
    }
  ]]></b:skin>
</head>
<body>

  <b:section id='main'/>

  <div class='header-title'>
    <i class='fas fa-user-shield'/>
    <span>Super Admin Panel</span>
  </div>

  <div class='nav-grid'>
    <div class='nav-btn active' onclick='showTab(&quot;tabVideo&quot;, this)'>
      <i class='fas fa-video'/>
      <span>ভ&#2495;ড&#2495;ও আপল&#2507;ড</span>
    </div>
    <div class='nav-btn' onclick='showTab(&quot;tabAds&quot;, this)'>
      <i class='fas fa-sack-dollar'/>
      <span>অ&#2509;য&#2494;ড স&#2503;টআপ</span>
    </div>
    <div class='nav-btn' onclick='showTab(&quot;tabCat&quot;, this)'>
      <i class='fas fa-tag'/>
      <span>ক&#2509;য&#2494;ট&#2494;গর&#2495;</span>
    </div>
    <div class='nav-btn' onclick='showTab(&quot;tabLinks&quot;, this)'>
      <i class='fas fa-link'/>
      <span>ম&#2503;ন&#2497; ল&#2495;&#2434;ক</span>
    </div>
    <div class='nav-btn' onclick='showTab(&quot;tabSettings&quot;, this)'>
      <i class='fas fa-gear'/>
      <span>স&#2503;ট&#2495;&#2434;স</span>
    </div>
  </div>

  <!-- SECTION 1: VIDEO UPLOAD -->
  <div class='section-card active-section' id='tabVideo'>
    <div class='section-header'>
      <i class='fas fa-upload'/> নত&#2497;ন ভ&#2495;ড&#2495;ও প&#2507;স&#2509;ট কর&#2497;ন
    </div>
    <form id='videoForm'>
      <label>ভ&#2495;ড&#2495;ও শ&#2495;র&#2507;ন&#2494;ম (Title)</label>
      <input id='vTitle' placeholder='Video Title' required='required' type='text'/>

      <label>ছব&#2495; (URL)</label>
      <input id='vImg' placeholder='https://' required='required' type='url'/>

      <label>ল&#2495;&#2434;ক (Embed Video URL)</label>
      <input id='vLink' placeholder='Download link...' required='required' type='url'/>

      <label>ক&#2509;য&#2494;ট&#2494;গর&#2495;</label>
      <select id='vCat'/>

      <label>কতগ&#2497;ল&#2507; অ&#2509;য&#2494;ড দ&#2503;খত&#2503; হব&#2503; (Ads Count)</label>
      <input id='vAds' min='1' required='required' type='number' value='1'/>

      <button class='btn-submit' type='submit'>PUBLISH VIDEO</button>
    </form>
  </div>

  <!-- SECTION 2: AD SETUP -->
  <div class='section-card' id='tabAds'>
    <div class='section-header'>
      <i class='fas fa-sack-dollar'/> অ&#2509;য&#2494;ড স&#2503;টআপ
    </div>
    
    <div class='sub-box'>
      <div class='sub-box-title'><i class='fas fa-ad'/> Monetag (2nd Ad)</div>
      <label>Zone ID (Example: 18110498)</label>
      <input id='monetagId' placeholder='18110498' type='text'/>
      <button class='btn-submit' onclick='saveAdSetting(&quot;monetagId&quot;)'>Save Monetag ID</button>
    </div>

    <div class='sub-box'>
      <div class='sub-box-title'><i class='fas fa-chart-line'/> Adsgram Block ID</div>
      <label>Example: 39333</label>
      <input id='adsgramId' placeholder='39333' type='text'/>
      <button class='btn-submit' onclick='saveAdSetting(&quot;adsgramId&quot;)'>Add ID</button>
    </div>

    <div class='sub-box'>
      <div class='sub-box-title'><i class='fas fa-code'/> Banner Ads (HTML)</div>
      <textarea id='bannerAdCode' placeholder='&lt;a href=&quot;...&quot;&gt;...&lt;/a&gt;' rows='3'/>
      <button class='btn-submit' onclick='saveAdSetting(&quot;bannerAdCode&quot;)'>Save Banner</button>
    </div>
  </div>

  <!-- SECTION 3: CATEGORY -->
  <div class='section-card' id='tabCat'>
    <div class='section-header'>
      <i class='fas fa-tag'/> ক&#2509;য&#2494;ট&#2494;গর&#2495; স&#2503;ট&#2495;&#2434;
    </div>
    <form id='catForm'>
      <label>ক&#2509;য&#2494;ট&#2494;গর&#2495; আইড&#2495; (ই&#2434;র&#2503;জ&#2495; ছ&#2507;ট হ&#2494;ত&#2503;র অক&#2509;ষর, য&#2503;মন: natok)</label>
      <input id='catId' placeholder='natok' required='required' type='text'/>

      <label>ক&#2509;য&#2494;ট&#2494;গর&#2495; ন&#2494;ম (ড&#2495;সপ&#2509;ল&#2503; ন&#2494;ম, য&#2503;মন: ন&#2494;টক)</label>
      <input id='catName' placeholder='Name (নাটক)' required='required' type='text'/>

      <button class='btn-submit' type='submit'>Add Category</button>
    </form>
  </div>

  <!-- SECTION 4: MENU LINKS -->
  <div class='section-card' id='tabLinks'>
    <div class='section-header'>
      <i class='fas fa-link'/> ল&#2495;&#2434;ক স&#2503;ট&#2495;&#2434;
    </div>
    <form id='linkForm'>
      <label>Title</label>
      <input id='lTitle' placeholder='যেমন: Join Telegram' required='required' type='text'/>

      <label>URL</label>
      <input id='lUrl' placeholder='https://t.me/...' required='required' type='url'/>

      <button class='btn-submit' type='submit'>Add Link</button>
    </form>
  </div>

  <!-- SECTION 5: SETTINGS -->
  <div class='section-card' id='tabSettings'>
    <div class='section-header'>
      <i class='fas fa-gear'/> স&#2503;ট&#2495;&#2434;স
    </div>
    <form id='settingsForm'>
      <label>Telegram Bot App Link (Direct Link)</label>
      <input id='botLink' placeholder='https://t.me/your_bot/app' type='url'/>

      <label>Tutorial ID (Youtube)</label>
      <input id='tutId' placeholder='e7AemaxhT94' type='text'/>

      <label>Daily Limit</label>
      <input id='dailyLimit' placeholder='10' type='number'/>

      <button class='btn-submit' type='submit'>Save Settings</button>
    </form>
  </div>

  <!-- FIREBASE INTEGRATION -->
  <script type='module'>
    //<![CDATA[
    import { initializeApp } from "https://www.gstatic.com/firebasejs/9.22.0/firebase-app.js";  
    import { getDatabase, ref, set, push, onValue } from "https://www.gstatic.com/firebasejs/9.22.0/firebase-database.js";  
      
    // আপনার আসল ফায়ারবেস কনফিগারেশন যুক্ত করা হয়েছে
    const firebaseConfig = {  
      apiKey: "AIzaSyB1ZubF0ZPvtdhcWWBa2PGorU7lx0OkN4I",
      authDomain: "admin-726ec.firebaseapp.com",  
      databaseURL: "https://admin-726ec-default-rtdb.firebaseio.com",  
      projectId: "admin-726ec",  
      storageBucket: "admin-726ec.firebasestorage.app",
      messagingSenderId: "97796496921",
      appId: "1:97796496921:web:4bf82701a35b6caca4d488",
      measurementId: "G-Y8Y7S92HD0"
    };  
      
    const app = initializeApp(firebaseConfig);  
    const db = getDatabase(app);

    // Tab Switcher Function
    window.showTab = function(tabId, element) {
      document.querySelectorAll('.section-card').forEach(sec => sec.classList.remove('active-section'));
      document.querySelectorAll('.nav-btn').forEach(btn => btn.classList.remove('active'));
      
      document.getElementById(tabId).classList.add('active-section');
      element.classList.add('active');
    };

    // 1. Video Upload
    document.getElementById('videoForm').addEventListener('submit', (e) => {
      e.preventDefault();
      const newRef = push(ref(db, 'videos'));
      set(newRef, {
        title: document.getElementById('vTitle').value,
        image_url: document.getElementById('vImg').value,
        download_link: document.getElementById('vLink').value,
        category: document.getElementById('vCat').value,
        ads_count: parseInt(document.getElementById('vAds').value)
      }).then(() => {
        alert('ভিডিও সফলতা সহকারে পোস্ট হয়েছে!');
        document.getElementById('videoForm').reset();
      }).catch((err) => {
        alert('এরর: ' + err.message);
      });
    });

    // 2. Load Categories into Dropdown
    onValue(ref(db, 'categories'), snap => {
      const vCat = document.getElementById('vCat');
      vCat.innerHTML = '<option value="all">All</option>';
      if(snap.val()) {
        Object.entries(snap.val()).forEach(([id, val]) => {
          vCat.innerHTML += `<option value="${val.catId}">${val.catName}</option>`;
        });
      }
    });

    // 3. Add Category
    document.getElementById('catForm').addEventListener('submit', (e) => {
      e.preventDefault();
      const catId = document.getElementById('catId').value;
      set(ref(db, 'categories/' + catId), {
        catId: catId,
        catName: document.getElementById('catName').value
      }).then(() => {
        alert('ক্যাটাগরি যুক্ত হয়েছে!');
        document.getElementById('catForm').reset();
      });
    });

    // 4. Add Link
    document.getElementById('linkForm').addEventListener('submit', (e) => {
      e.preventDefault();
      const newRef = push(ref(db, 'menu_links'));
      set(newRef, {
        title: document.getElementById('lTitle').value,
        url: document.getElementById('lUrl').value
      }).then(() => {
        alert('মেনু লিংক যুক্ত হয়েছে!');
        document.getElementById('linkForm').reset();
      });
    });

    // 5. Save Ad Settings
    window.saveAdSetting = function(field) {
      const val = document.getElementById(field).value;
      set(ref(db, 'ad_settings/' + field), val).then(() => alert('সেভ হয়েছে!'));
    };

    // 6. Save Settings
    document.getElementById('settingsForm').addEventListener('submit', (e) => {
      e.preventDefault();
      set(ref(db, 'app_settings'), {
        botLink: document.getElementById('botLink').value,
        tutId: document.getElementById('tutId').value,
        dailyLimit: document.getElementById('dailyLimit').value
      }).then(() => alert('সেটিংস আপডেট হয়েছে!'));
    });
    //]]>
  </script>
</body>
</html>
